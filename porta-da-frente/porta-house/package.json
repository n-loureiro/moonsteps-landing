{
  "name": "porta-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porta da Frente listings to evidence-based interactive architectural models",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "esbuild web/viewer.js --bundle --format=iife --target=es2020 --minify --outfile=web/viewer.bundle.js",
    "collect": "node src/cli.mjs collect",
    "generate": "node src/cli.mjs generate"
  },
  "dependencies": { "ajv": "8.17.1", "playwright": "1.56.1", "three": "0.180.0" },
  "devDependencies": { "esbuild": "0.25.10" }
}
