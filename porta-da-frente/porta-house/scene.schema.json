{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "units": {
      "type": "string",
      "const": "metres"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      },
      "minItems": 1,
      "maxItems": 40
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 50
          },
          "name": {
            "type": "string",
            "maxLength": 4000
          },
          "elevation": {
            "type": "number",
            "minimum": -100,
            "maximum": 200
          }
        },
        "required": [
          "id",
          "name",
          "elevation"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "box",
              "slab",
              "wall",
              "hip_roof",
              "gable_roof",
              "roof_mesh",
              "pool",
              "tree",
              "sofa",
              "bed",
              "table",
              "chair",
              "kitchen",
              "stairs",
              "cylinder"
            ]
          },
          "layer": {
            "type": "string",
            "enum": [
              "site",
              "floors",
              "walls",
              "roof",
              "furniture"
            ]
          },
          "level": {
            "type": "string",
            "maxLength": 50
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            "minItems": 3,
            "maxItems": 3
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 200
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "points": {
            "type": "array",
            "maxItems": 1200,
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 500
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 500
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              ]
            }
          },
          "openings": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                },
                "width": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 100
                },
                "height": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 30
                },
                "sill": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "window",
                    "door"
                  ]
                }
              },
              "required": [
                "offset",
                "width",
                "height",
                "sill",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "observed",
              "inferred",
              "unknown"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            },
            "minItems": 1,
            "maxItems": 40
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "layer",
          "level",
          "position",
          "size",
          "rotation",
          "color",
          "points",
          "openings",
          "confidence",
          "sources",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "summary",
    "units",
    "limitations",
    "levels",
    "objects"
  ],
  "additionalProperties": false
}